:- object(linear_programming_cli_test_solver,
	imports(linear_programming_cli)).

	:- public(assemble_test_result/9).

	assemble_test_result(Solver, Problem, RawStatus, NormalizedStatus, Status, Objective, SolutionData, Text, Result) :-
		^^assemble_result(Solver, Problem, RawStatus, NormalizedStatus, Status, Objective, SolutionData, Text, Result).

:- end_object.


:- object(lp_format_tests,
	extends(lgtunit)).

	:- info([
		version is 1:0:1,
		author is 'Paulo Moura',
		date is 2026-11-27,
		comment is 'Unit tests for the LP format generator and the process runner of the "linear_programming" library backends.'
	]).

	:- uses(lgtunit, [
		assertion/1
	]).

	:- uses(list, [
		append/3, memberchk/2
	]).

	cover(lp_format).
	cover(linear_programming_process).

	test(lp_format_classic_example, deterministic(Atom == '\\ Problem generated by the Logtalk linear_programming library\nMaximize\n obj: 3 x1 + 4 x2\nSubject To\n c1: 1 x1 + 2 x2 <= 14\n c2: 3 x1 - 1 x2 >= 0\n c3: 1 x1 - 1 x2 <= 2\nBounds\n 0 <= x1\n 0 <= x2\nEnd\n')) :-
		build([v(x, continuous, 0, inf), v(y, continuous, 0, inf)], [c([1*x, 2*y], =<, 14), c([3*x, -1*y], >=, 0), c([1*x, -1*y], =<, 2)], o([3*x, 4*y], maximize), Problem),
		lp_format::generate(Problem, Codes),
		atom_codes(Atom, Codes).

	test(lp_format_variable_types_and_bounds, deterministic(Atom == '\\ Problem generated by the Logtalk linear_programming library\nMinimize\n obj: -2 x1 + 0 x2 + 0 x3 + 1 x4 + 0 x5\nSubject To\n c1: 1 x2 + 1 x3 = 4\nBounds\n -3 <= x1 <= 5\n x2 free\n -inf <= x3 <= 7\n 0 <= x4 <= 1\n 2 <= x5\nGeneral\n x4\n x5\nEnd\n')) :-
		build(
			[v(a, continuous, -3, 5), v(b, continuous, -inf, inf), v(c, continuous, -inf, 7), v(d, binary, 0, 1), v(e, integer, 2, inf)],
			[c([1*b, 1*c], =, 4)],
			o([-2*a, 1*d], minimize),
			Problem
		),
		lp_format::generate(Problem, Codes),
		atom_codes(Atom, Codes).

	test(lp_format_empty_constraint_uses_first_variable, deterministic) :-
		build([v(x, continuous, 0, inf)], [c([], =<, 5)], o([1*x], maximize), Problem),
		lp_format::generate(Problem, Codes),
		atom_codes(Atom, Codes),
		assertion(sub_atom(Atom, _, _, _, ' c1: 0 x1 <= 5\n')).

	test(lp_format_float_coefficients, deterministic) :-
		build([v(x, continuous, 0, inf)], [c([0.5*x], =<, 2.25)], o([1.5*x], maximize), Problem),
		lp_format::generate(Problem, Codes),
		atom_codes(Atom, Codes),
		assertion(sub_atom(Atom, _, _, _, 'obj: 1.5 x1\n')),
		assertion(sub_atom(Atom, _, _, _, ' c1: 0.5 x1 <= 2.25\n')).

	test(lp_format_many_terms_are_split_in_lines, deterministic) :-
		numbered_variables(8, Variables, Expression),
		build(Variables, [], o(Expression, maximize), Problem),
		lp_format::generate(Problem, Codes),
		atom_codes(Atom, Codes),
		assertion(sub_atom(Atom, _, _, _, ' + 1 x6\n    + 1 x7')).

	test(lp_format_variable_names, deterministic(Pairs == [x(1,2)-x1, y-x2])) :-
		build([v(x(1,2), continuous, 0, inf), v(y, continuous, 0, inf)], [], o([1*y], maximize), Problem),
		lp_format::variable_names(Problem, Pairs).

	test(lp_format_missing_objective, error(type_error(linear_program, _))) :-
		simplex::new_problem(Problem0),
		simplex::variable(x, continuous, Problem0, Problem),
		lp_format::generate(Problem, _).

	test(lp_format_invalid_problem, error(type_error(linear_program, foo))) :-
		lp_format::generate(foo, _).

	test(linear_programming_cli_rejects_missing_solution, error(domain_error(linear_programming_output, missing_solution))) :-
		zero_problem(Problem),
		linear_programming_cli_test_solver::assemble_test_result(test, Problem, exit(0), exit(0), optimal, 0, none, 'Optimal', _).

	test(linear_programming_cli_rejects_missing_objective, error(domain_error(linear_programming_output, missing_solution))) :-
		zero_problem(Problem),
		linear_programming_cli_test_solver::assemble_test_result(test, Problem, exit(0), exit(0), feasible, none, solution([1-0]), 'Feasible', _).

	test(linear_programming_cli_rejects_duplicate_solution_pairs, error(domain_error(linear_programming_output, missing_solution))) :-
		zero_problem(Problem),
		linear_programming_cli_test_solver::assemble_test_result(test, Problem, exit(0), exit(0), optimal, 0, solution([1-0,1-0]), 'Optimal', _).

	test(linear_programming_cli_rejects_inconsistent_solution, error(domain_error(linear_programming_output, inconsistent_solution))) :-
		zero_problem(Problem),
		linear_programming_cli_test_solver::assemble_test_result(test, Problem, exit(0), exit(0), optimal, 1, solution([]), 'Optimal', _).

	test(linear_programming_cli_rejects_infeasible_solution, error(domain_error(linear_programming_output, inconsistent_solution))) :-
		constrained_problem(Problem),
		linear_programming_cli_test_solver::assemble_test_result(test, Problem, exit(0), exit(0), optimal, 0, solution([]), 'Optimal', _).

	test(linear_programming_cli_rejects_fractional_integer_solution, error(domain_error(linear_programming_output, inconsistent_solution))) :-
		integer_problem(Problem),
		linear_programming_cli_test_solver::assemble_test_result(test, Problem, exit(0), exit(0), optimal, 0.5, solution([1-0.5]), 'Optimal', _).

	test(linear_programming_cli_accepts_explicit_zero_solution, deterministic((Status == optimal, X =:= 0, Objective == 0))) :-
		zero_problem(Problem),
		linear_programming_cli_test_solver::assemble_test_result(test, Problem, exit(0), exit(0), optimal, 0, solution([]), 'Optimal', Result),
		simplex::status(Result, Status),
		simplex::variable_value(Result, x, X),
		simplex::objective_value(Result, Objective).

	% process runner placeholder tests (POSIX shell tools)

	test(linear_programming_process_input_is_appended, deterministic, [condition(os::resolve_command_path(cat, _))]) :-
		atom_codes('some problem\n', Codes),
		linear_programming_process::run(cat, [], codes(Codes), Output, Solution, Diagnostics, _, Status),
		assertion(Output == Codes),
		assertion(Solution == []),
		assertion(Diagnostics == []),
		assertion(Status == exit(0)).

	test(linear_programming_process_input_and_solution_placeholders, deterministic, [condition(os::resolve_command_path(sh, _))]) :-
		atom_codes('data\n', Codes),
		linear_programming_process::run(sh, ['-c', 'cat "$0" > "$1"; echo done', '$input', '$solution'], codes(Codes), Output, Solution, _, _, Status),
		assertion(Solution == Codes),
		assertion(Output == [0'd, 0'o, 0'n, 0'e, 10]),
		assertion(Status == exit(0)).

	test(linear_programming_process_concatenated_argument, deterministic, [condition(os::resolve_command_path(sh, _))]) :-
		atom_codes('x', Codes),
		linear_programming_process::run(sh, ['-c', ['cat ', '$input', ' | tr x y']], codes(Codes), Output, _, _, _, _),
		assertion(Output == [0'y]).

	test(linear_programming_process_exit_status, deterministic, [condition(os::resolve_command_path(sh, _))]) :-
		linear_programming_process::run(sh, ['-c', 'exit 3'], codes([]), _, _, _, _, Status),
		% some backends (e.g., GNU Prolog) cannot normalize nonzero exit codes
		assertion(memberchk(Status, [exit(3), unknown(3)])).

	test(linear_programming_process_invalid_source, error(domain_error(linear_programming_process_source, foo))) :-
		linear_programming_process::run(sh, [], foo, _, _, _, _, _).

	test(linear_programming_process_invalid_argument, error(type_error(atom, 1))) :-
		linear_programming_process::run(sh, [['a', 1]], codes([]), _, _, _, _, _).

	test(linear_programming_process_quote_posix, deterministic(Quoted == '\'a\'"\'"\'b\'')) :-
		linear_programming_process::quote(posix, 'a\'b', Quoted).

	% auxiliary predicates

	indexed_name(Prefix, Index, Name) :-
		number_codes(Index, IndexCodes),
		atom_codes(Prefix, PrefixCodes),
		append(PrefixCodes, IndexCodes, NameCodes),
		atom_codes(Name, NameCodes).

	build(Variables, Constraints, o(Expression, Sense), Problem) :-
		simplex::new_problem(Problem0),
		add_variables(Variables, Problem0, Problem1),
		add_constraints(Constraints, Problem1, Problem2),
		simplex::objective(Expression, Sense, Problem2, Problem).

	add_variables([], Problem, Problem).
	add_variables([v(Name, Type, Lower, Upper)| Variables], Problem0, Problem) :-
		simplex::variable(Name, Type, Lower, Upper, Problem0, Problem1),
		add_variables(Variables, Problem1, Problem).

	add_constraints([], Problem, Problem).
	add_constraints([c(Expression, Sense, RightHandSide)| Constraints], Problem0, Problem) :-
		simplex::constraint(Expression, Sense, RightHandSide, Problem0, Problem1),
		add_constraints(Constraints, Problem1, Problem).

	zero_problem(Problem) :-
		build([v(x, continuous, 0, 1)], [], o([1*x], maximize), Problem).

	constrained_problem(Problem) :-
		build([v(x, continuous, 0, 1)], [c([1*x], >=, 1)], o([1*x], maximize), Problem).

	integer_problem(Problem) :-
		build([v(x, integer, 0, 1)], [], o([1*x], maximize), Problem).

	numbered_variables(Count, Variables, Expression) :-
		numbered_variables(1, Count, Variables, Expression).

	numbered_variables(Index, Count, Variables, Expression) :-
		(	Index > Count ->
			Variables = [],
			Expression = []
		;	indexed_name(v, Index, Name),
			Variables = [v(Name, continuous, 0, 1)| Variables1],
			Expression = [1*Name| Expression1],
			Next is Index + 1,
			numbered_variables(Next, Count, Variables1, Expression1)
		).

:- end_object.
