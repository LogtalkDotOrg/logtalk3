:- object(lp_format).

	:- info([
		version is 1:0:0,
		author is 'Paulo Moura',
		date is 2026-11-27,
		comment is 'Generates CPLEX LP format source (understood by GLPK, CBC, HiGHS, SCIP, and most other solvers) from ``linear_program/3`` problems. Variables are written using the generated names ``x1``, ``x2``, ... in declaration order (all variables are listed in the objective, with a zero coefficient if necessary, to keep them and their order), constraints as ``c1``, ``c2``, ..., and the objective as ``obj``.'
	]).

	:- public(generate/2).
	:- mode(generate(+compound, -list(code)), one_or_error).
	:- info(generate/2, [
		comment is 'Generates LP format character codes for a problem with variables and an objective.',
		argnames is ['Problem', 'Codes'],
		exceptions is [
			'``Problem`` is not a ``linear_program/3`` term with an objective' - type_error(linear_program, 'Problem')
		]
	]).

	:- public(variable_names/2).
	:- mode(variable_names(+compound, -list(pair)), one).
	:- info(variable_names/2, [
		comment is 'Returns the ``Name-GeneratedName`` pairs of the variables of a problem.',
		argnames is ['Problem', 'Pairs']
	]).

	:- uses(list, [
		member/2
	]).

	generate(Problem, Codes) :-
		(	Problem = linear_program(Variables, Constraints, objective(Expression, Sense)) ->
			phrase(problem(Variables, Constraints, Expression, Sense), Codes)
		;	type_error(linear_program, Problem)
		).

	variable_names(linear_program(Variables, _, _), Pairs) :-
		variable_names(Variables, 1, Pairs).

	variable_names([], _, []).
	variable_names([variable(Name, _, _, _)| Variables], Index, [Name-Generated| Pairs]) :-
		generated_name(Index, Generated),
		Next is Index + 1,
		variable_names(Variables, Next, Pairs).

	generated_name(Index, Name) :-
		number_codes(Index, Codes),
		atom_codes(Name, [0'x| Codes]).

	problem(Variables, Constraints, Expression, Sense) -->
		text('\\ Problem generated by the Logtalk linear_programming library\n'),
		sense(Sense),
		text(' obj: '),
		objective_terms(Variables, Expression),
		[10],
		text('Subject To\n'),
		(	{ Constraints == [] } ->
			% some solvers (e.g., GLPK) reject an empty constraints section
			text(' c1: 0 x1 >= 0\n')
		;	constraints(Constraints, Variables, 1)
		),
		bounds(Variables),
		general(Variables),
		text('End\n').

	sense(minimize) -->
		text('Minimize\n').
	sense(maximize) -->
		text('Maximize\n').

	% every variable is listed in the objective, using a zero coefficient if necessary
	objective_terms(Variables, Expression) -->
		{ expression_terms(Variables, Expression, 1, Terms) },
		terms(Terms, 0).

	expression_terms([], _, _, []).
	expression_terms([variable(Name, _, _, _)| Variables], Expression, Index, [Coefficient-Index| Terms]) :-
		coefficient(Expression, Name, Coefficient),
		Next is Index + 1,
		expression_terms(Variables, Expression, Next, Terms).

	coefficient([], _, 0).
	coefficient([Coefficient*Name0| Expression], Name, Value) :-
		(	Name0 == Name ->
			Value = Coefficient
		;	coefficient(Expression, Name, Value)
		).

	% constraints use only the variables that occur in them; an empty constraint
	% uses the first variable with a zero coefficient
	constraints([], _, _) -->
		[].
	constraints([constraint(Expression, Sense, RightHandSide)| Constraints], Variables, Index) -->
		text(' c'), integer_text(Index), text(': '),
		{ constraint_terms(Expression, Variables, Terms) },
		terms(Terms, 0),
		[0' ], relation(Sense), [0' ], number_text(RightHandSide), [10],
		{ Next is Index + 1 },
		constraints(Constraints, Variables, Next).

	constraint_terms([], _, [0-1]) :-
		!.
	constraint_terms(Expression, Variables, Terms) :-
		variable_indexes(Variables, 1, Indexes),
		expression_with_indexes(Expression, Indexes, Terms).

	variable_indexes([], _, []).
	variable_indexes([variable(Name, _, _, _)| Variables], Index, [Name-Index| Indexes]) :-
		Next is Index + 1,
		variable_indexes(Variables, Next, Indexes).

	expression_with_indexes([], _, []).
	expression_with_indexes([Coefficient*Name| Expression], Indexes, [Coefficient-Index| Terms]) :-
		member(Name0-Index, Indexes),
		Name0 == Name,
		!,
		expression_with_indexes(Expression, Indexes, Terms).

	relation(=<) -->
		text('<=').
	relation(>=) -->
		text('>=').
	relation(=) -->
		text('=').

	% terms are written a few per line to keep lines short
	terms([], _) -->
		[].
	terms([Coefficient-Index| Terms], Count) -->
		(	{ Count > 0, 0 =:= Count mod 6 } ->
			text('\n   ')
		;	[]
		),
		term(Coefficient, Index, Count),
		{ Count1 is Count + 1 },
		terms(Terms, Count1).

	term(Coefficient, Index, Count) -->
		(	{ Count =:= 0 } ->
			(	{ Coefficient < 0 } ->
				[0'-], { Magnitude is -Coefficient }, number_text(Magnitude)
			;	number_text(Coefficient)
			)
		;	{ Coefficient < 0 } ->
			text(' - '), { Magnitude is -Coefficient }, number_text(Magnitude)
		;	text(' + '), number_text(Coefficient)
		),
		[0' ], variable_text(Index).

	bounds(Variables) -->
		text('Bounds\n'),
		variable_bounds(Variables, 1).

	variable_bounds([], _) -->
		[].
	variable_bounds([variable(_, _, Lower, Upper)| Variables], Index) -->
		bound_line(Lower, Upper, Index),
		{ Next is Index + 1 },
		variable_bounds(Variables, Next).

	bound_line(-inf, inf, Index) -->
		!,
		[0' ], variable_text(Index), text(' free\n').
	bound_line(-inf, Upper, Index) -->
		!,
		text(' -inf <= '), variable_text(Index), text(' <= '), number_text(Upper), [10].
	bound_line(Lower, inf, Index) -->
		!,
		[0' ], number_text(Lower), text(' <= '), variable_text(Index), [10].
	bound_line(Lower, Upper, Index) -->
		[0' ], number_text(Lower), text(' <= '), variable_text(Index), text(' <= '), number_text(Upper), [10].

	% integer and binary variables (binary variables have bounds between 0 and 1)
	general(Variables) -->
		{ discrete_indexes(Variables, 1, Indexes) },
		(	{ Indexes == [] } ->
			[]
		;	text('General\n'),
			discrete_lines(Indexes)
		).

	discrete_indexes([], _, []).
	discrete_indexes([variable(_, Type, _, _)| Variables], Index, Indexes) :-
		Next is Index + 1,
		(	Type == continuous ->
			Indexes = Indexes1
		;	Indexes = [Index| Indexes1]
		),
		discrete_indexes(Variables, Next, Indexes1).

	discrete_lines([]) -->
		[].
	discrete_lines([Index| Indexes]) -->
		[0' ], variable_text(Index), [10],
		discrete_lines(Indexes).

	variable_text(Index) -->
		{ generated_name(Index, Name), atom_codes(Name, Codes) },
		codes(Codes).

	integer_text(Integer) -->
		{ number_codes(Integer, Codes) },
		codes(Codes).

	number_text(Number) -->
		{ number_codes(Number, Codes) },
		codes(Codes).

	text(Atom) -->
		{ atom_codes(Atom, Codes) },
		codes(Codes).

	codes([]) -->
		[].
	codes([Code| Codes]) -->
		[Code],
		codes(Codes).

:- end_object.
