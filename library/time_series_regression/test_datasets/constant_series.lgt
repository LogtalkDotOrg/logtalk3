:- object(constant_series,
	implements(time_series_dataset_protocol)).

	:- info([
		version is 1:0:0,
		author is 'Paulo Moura',
		date is 2026-09-28,
		comment is 'Constant series (all observations equal to 5), which makes the intercept and lag columns of an AR(1) design matrix collinear.'
	]).

	observation(1, 5).
	observation(2, 5).
	observation(3, 5).
	observation(4, 5).
	observation(5, 5).
	observation(6, 5).

	series_length(6).

:- end_object.
