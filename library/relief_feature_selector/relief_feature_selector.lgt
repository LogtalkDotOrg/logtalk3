:- object(relief_feature_selector,
	imports(relief_feature_selector_common)).

	:- info([
		version is 1:0:0,
		author is 'Paulo Moura',
		date is 2026-10-07,
		comment is 'Binary Relief feature selection with one nearest hit and miss.'
	]).

	relief_model(relief_feature_selector).
	relief_variant(binary).

:- end_object.
