:- object(linear_trend,
	implements(time_series_dataset_protocol)).

	:- info([
		version is 1:0:0,
		author is 'Paulo Moura',
		date is 2026-09-27,
		comment is 'Simple non-seasonal time series following the line value = 2*index + 8 (values 10, 12, 14, 16, 18, 20).'
	]).

	observation(1, 10).
	observation(2, 12).
	observation(3, 14).
	observation(4, 16).
	observation(5, 18).
	observation(6, 20).

	series_length(6).

:- end_object.
