' =========================================================================
' Skinparams: per-stereotype colors for entities
' =========================================================================

skinparam classBackgroundColor<<object>>              #D6EAF8
skinparam classBorderColor<<object>>                  #2980B9
skinparam classBackgroundColor<<protocol>>            #D5F5E3
skinparam classBorderColor<<protocol>>                #1E8449
skinparam classBackgroundColor<<category>>            #FDEBD0
skinparam classBorderColor<<category>>                #CA6F1E
