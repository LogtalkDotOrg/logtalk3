skinparam packageBackgroundColor<<entity>>      #FFFAFA
skinparam packageBorderColor<<entity>>          #A9A9A9
skinparam packageFontName Monospace
skinparam packageFontSize 10
skinparam packageStyle rectangle

' =========================================================================
' General settings
' =========================================================================

skinparam defaultFontName Monospace
skinparam defaultFontSize 10

hide stereotype
