skinparam classBorderColor<<exported_predicate>>      #27AE60
skinparam classBackgroundColor<<external_predicate>>  #F2F4F4
skinparam classBorderColor<<external_predicate>>      #D5DBDB
skinparam classFontColor<<external_predicate>>        #5D6D7E
skinparam classFontName Monospace
skinparam classFontSize 10

skinparam RoundCorner<<category>> 15
skinparam RoundCorner<<external_category>> 15

' =========================================================================
' Package styles
' =========================================================================

skinparam packageBackgroundColor<<rlibrary>>    #D3D3D3
skinparam packageBorderColor<<rlibrary>>        #A9A9A9
skinparam packageBackgroundColor<<libraries>>   #D3D3D3
skinparam packageBorderColor<<libraries>>       #A9A9A9
