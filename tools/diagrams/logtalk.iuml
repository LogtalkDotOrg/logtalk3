skinparam classBorderColor<<external_file>>           #85C1E9
skinparam classFontColor<<external_file>>             #5D6D7E
skinparam classBackgroundColor<<external_directory>>  #FDEDEC
skinparam classBorderColor<<external_directory>>      #F1948A
skinparam classFontColor<<external_directory>>        #5D6D7E
skinparam classBackgroundColor<<external_library>>    #FDEDEC
skinparam classBorderColor<<external_library>>        #F1948A
skinparam classFontColor<<external_library>>          #5D6D7E
skinparam classBackgroundColor<<directive>>           #FDEBD0
skinparam classBorderColor<<directive>>               #E67E22
skinparam classBackgroundColor<<predicate>>           #F2F3F4
skinparam classBorderColor<<predicate>>               #BDC3C7
